{
  "manifest_version": 2,
  "mod": {
    "id": "panel-management-framework",
    "name": "Framework: Panels",
    "area": "Framework",
    "version": "0.2.0-dev.2.bo.5",
    "author": "shaboogen",
    "description": "Lets mods add their own panels to Bitwig's layout, each with a button, a Show action and a scale, and lets mods arrange and scale Bitwig's own panels. Bo's build: views can also be a tab of the browser side (View.side(\"browser\"), first with View.sideFirst(true), or a column of its own beside it with View.sideColumn).",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "bml.panels.PanelHooks"
  },
  "targets": {
    "alq.cfM": {
      "kind": "method",
      "owner": "alq",
      "name": "cfM",
      "descriptor": "()LajC;"
    },
    "als.cfM": {
      "kind": "method",
      "owner": "als",
      "name": "cfM",
      "descriptor": "()LakC;"
    },
    "alu.UNj": {
      "kind": "method",
      "owner": "alu",
      "name": "UNj",
      "descriptor": "()LajC;"
    },
    "alp.cfM": {
      "kind": "method",
      "owner": "alp",
      "name": "cfM",
      "descriptor": "()LajC;"
    },
    "aln.cfM": {
      "kind": "method",
      "owner": "aln",
      "name": "cfM",
      "descriptor": "()LajC;"
    },
    "alo.cfM": {
      "kind": "method",
      "owner": "alo",
      "name": "cfM",
      "descriptor": "()LajC;"
    },
    "alt.MRY": {
      "kind": "method",
      "owner": "alt",
      "name": "MRY",
      "descriptor": "()LakC;"
    },
    "alv.cfM": {
      "kind": "method",
      "owner": "alv",
      "name": "cfM",
      "descriptor": "()LajC;"
    },
    "dnf.cfM": {
      "kind": "method",
      "owner": "dnf",
      "name": "cfM",
      "descriptor": "(Ljava/lang/String;D)Lcom/bitwig/graphics/BrJ;"
    },
    "dnf.FzB": {
      "kind": "method",
      "owner": "dnf",
      "name": "FzB",
      "descriptor": "(Ljava/lang/String;D)Lcom/bitwig/graphics/BrJ;"
    },
    "aBW.LEd": {
      "kind": "method",
      "owner": "aBW",
      "name": "LEd",
      "descriptor": "()Ldve;"
    },
    "akC.cfM": {
      "kind": "method",
      "owner": "akC",
      "name": "cfM",
      "descriptor": "(LaBW;Lcom/bitwig/base/geom/IBe;)Ldve;"
    },
    "akQ.cfM": {
      "kind": "method",
      "owner": "akQ",
      "name": "cfM",
      "descriptor": "(LaBW;Z)Ldve;"
    },
    "dXx.cfM": {
      "kind": "method",
      "owner": "dXx",
      "name": "cfM",
      "descriptor": "(Ldve;Lcom/bitwig/base/geom/Jkg;)LdXx;"
    },
    "akZ.cfM": {
      "kind": "method",
      "owner": "akZ",
      "name": "cfM",
      "descriptor": "(LaBW;Z)Ldve;"
    },
    "aCU.cfM": {
      "kind": "method",
      "owner": "aCU",
      "name": "cfM",
      "descriptor": "(LakZ;LaBW;)LaCU;"
    },
    "com.bitwig.flt.document_view_settings.gJi.cfM": {
      "kind": "method",
      "owner": "com/bitwig/flt/document_view_settings/gJi",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/flt/document_view_settings/gJi;)V"
    },
    "akQ.Hnt": {
      "kind": "method",
      "owner": "akQ",
      "name": "Hnt",
      "descriptor": "(LdWb;LaBW;)V"
    },
    "akQ.FzB": {
      "kind": "method",
      "owner": "akQ",
      "name": "FzB",
      "descriptor": "(LaBW;)LdAd;"
    },
    "aYH.MRY": {
      "kind": "field",
      "owner": "aYH",
      "name": "MRY",
      "descriptor": "Lakw;"
    },
    "dXs.MRY": {
      "kind": "field",
      "owner": "dXs",
      "name": "MRY",
      "descriptor": "Z"
    },
    "aYH.init": {
      "kind": "method",
      "owner": "aYH",
      "name": "<init>",
      "descriptor": "()V"
    },
    "aYH.ELS": {
      "kind": "method",
      "owner": "aYH",
      "name": "ELS",
      "descriptor": "()Legv;"
    },
    "ajF.init": {
      "kind": "method",
      "owner": "ajF",
      "name": "<init>",
      "descriptor": "()V"
    },
    "akQ.init": {
      "kind": "method",
      "owner": "akQ",
      "name": "<init>",
      "descriptor": "()V"
    },
    "akZ.init": {
      "kind": "method",
      "owner": "akZ",
      "name": "<init>",
      "descriptor": "()V"
    },
    "dXx.init": {
      "kind": "method",
      "owner": "dXx",
      "name": "<init>",
      "descriptor": "()V"
    },
    "akQ.MRY-row": {
      "kind": "method",
      "owner": "akQ",
      "name": "MRY",
      "descriptor": "(LdWb;LaBW;)V"
    }
  },
  "hooks": [
    {
      "id": "single-large-monitor",
      "target": "alq.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "singleLargeMonitor",
        "descriptor": "(LajC;)LajC;",
        "args": []
      }
    },
    {
      "id": "single-small-monitor",
      "target": "als.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "singleSmallMonitor",
        "descriptor": "(LakC;)LakC;",
        "args": []
      }
    },
    {
      "id": "tablet",
      "target": "alu.UNj",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "tablet",
        "descriptor": "(LajC;)LajC;",
        "args": []
      }
    },
    {
      "id": "dual-monitor-studio",
      "target": "alp.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "dualMonitorStudio",
        "descriptor": "(LajC;)LajC;",
        "args": []
      }
    },
    {
      "id": "dual-monitor-arranger-mixer",
      "target": "aln.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "dualMonitorArrangerMixer",
        "descriptor": "(LajC;)LajC;",
        "args": []
      }
    },
    {
      "id": "dual-monitor-master-detail",
      "target": "alo.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "dualMonitorMasterDetail",
        "descriptor": "(LajC;)LajC;",
        "args": []
      }
    },
    {
      "id": "dual-display-studio-touch",
      "target": "alt.MRY",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "dualDisplayStudioTouch",
        "descriptor": "(LakC;)LakC;",
        "args": []
      }
    },
    {
      "id": "triple-monitor",
      "target": "alv.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "tripleMonitor",
        "descriptor": "(LajC;)LajC;",
        "args": []
      }
    },
    {
      "id": "panel-icons",
      "target": "dnf.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dnf.FzB",
        "occurrence": 1
      },
      "bridge": {
        "method": "loadSvgIcon",
        "descriptor": "(Ldnf;Ljava/lang/String;D)Lcom/bitwig/graphics/BrJ;",
        "args": []
      }
    },
    {
      "id": "view-buttons",
      "target": "aBW.LEd",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "akC.cfM",
        "occurrence": 1
      },
      "bridge": {
        "method": "viewButtons",
        "descriptor": "(LakC;LaBW;Lcom/bitwig/base/geom/IBe;)Ldve;",
        "args": []
      }
    },
    {
      "id": "view-wrap",
      "target": "akQ.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKESTATIC",
        "target": "dXx.cfM",
        "occurrence": 1
      },
      "bridge": {
        "method": "wrapPanel",
        "descriptor": "(Ldve;Lcom/bitwig/base/geom/Jkg;)LdXx;",
        "args": []
      }
    },
    {
      "id": "view-splitter",
      "target": "akZ.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKESTATIC",
        "target": "aCU.cfM",
        "occurrence": 1
      },
      "bridge": {
        "method": "splitter",
        "descriptor": "(LakZ;LaBW;)LaCU;",
        "args": []
      }
    },
    {
      "id": "settings-loaded",
      "target": "com.bitwig.flt.document_view_settings.gJi.cfM",
      "transform": "INSERT_BEFORE_FINAL_RETURN",
      "bridge": {
        "method": "settingsLoaded",
        "descriptor": "(Lcom/bitwig/flt/document_view_settings/gJi;)V",
        "args": [
          "this"
        ]
      }
    },
    {
      "id": "panel-scale",
      "target": "akQ.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "scalePanel",
        "descriptor": "(Ldve;)Ldve;",
        "args": []
      }
    },
    {
      "id": "side-buttons",
      "target": "akQ.Hnt",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "akQ.FzB",
        "occurrence": 1
      },
      "bridge": {
        "method": "sideButton",
        "descriptor": "(LakQ;LaBW;)LdAd;",
        "args": []
      }
    },
    {
      "id": "button-of",
      "target": "akQ.FzB",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "buttonOf",
        "descriptor": "(LakQ;)V",
        "args": [
          "this"
        ]
      }
    },
    {
      "id": "button-menu",
      "target": "akQ.FzB",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "buttonMenu",
        "descriptor": "(LdAd;)LdAd;",
        "args": []
      }
    }
  ],
  "opens": [
    "aYH.ELS",
    "aYH.MRY",
    "aYH.init",
    "ajF.init",
    "akQ.MRY-row",
    "akQ.init",
    "akZ.init",
    "dXs.MRY",
    "dXx.init",
    "dnf.FzB"
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    },
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
