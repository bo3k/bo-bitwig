{
  "manifest_version": 2,
  "mod": {
    "id": "insert-device-via-shortcut",
    "name": "Insert Device via Shortcut",
    "area": "Workflow",
    "version": "0.1.0-dev.2",
    "author": "Bo",
    "description": "Shortcuts, with no keys of their own, that insert Tool, Chain, Pro-Q 4 (VST3 or CLAP) and every Bitwig audio effect and instrument on the current track. Assign the keys in Settings > Shortcuts.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "targets": {},
  "hooks": [],
  "requires": [
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.7.0-dev.1"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
